{
  "name": "ainote",
  "productName": "나무 노트",
  "version": "1.2.0",
  "description": "스마트 노트 & 클립보드 매니저 (나무 노트)",
  "main": "main.js",
  "author": "Mokdua",
  "license": "ISC",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist:dir": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --win nsis --publish never",
    "release": "npm run build:renderer && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.mokdua.treenote",
    "productName": "나무 노트",
    "executableName": "TreeNote",
    "asar": true,
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer-dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "나무 노트",
      "artifactName": "TreeNote_Setup_${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SAN-50",
        "repo": "AINote"
      }
    ]
  }
}
